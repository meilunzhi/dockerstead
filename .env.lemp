# 时区
TZ=Asia/Shanghai

# 源码目录（网站文件存放位置）
SOURCE_DIR=./www

# 数据目录（MySQL、Redis等持久化数据）
DATA_DIR=./data

# ---------- Nginx ----------
NGINX_SSL_CERTIFICATE_DIR=./ssl
NGINX_CONFD_DIR=./services/nginx/conf.d
NGINX_CONF_FILE=./services/nginx/nginx.conf
NGINX_FASTCGI_PHP_CONF=./services/nginx/fastcgi-php.conf
NGINX_FASTCGI_PARAMS=./services/nginx/fastcgi_params
NGINX_LOG_DIR=./logs/nginx

# ---------- PHP 7.4 ----------
PHP74_VERSION=7.4.33
CONTAINER_PACKAGE_URL=mirrors.aliyun.com
COMPOSER_URL=https://getcomposer.org/download/latest-stable/composer.phar
PHP74_EXTENSIONS=pdo_mysql,redis,memcached,gd,zip,opcache
PHP74_PHP_CONF_FILE=./services/php74/php.ini
PHP74_FPM_CONF_FILE=./services/php74/www.conf
PHP74_LOG_DIR=./logs/php74

# ---------- MySQL 8.0 ----------
MYSQL_VERSION=8.0
MYSQL_HOST_PORT=3306
MYSQL_CONF_FILE=./services/mysql/my.cnf
MYSQL_LOG_DIR=./logs/mysql
MYSQL_ROOT_PASSWORD=root123
MYSQL_ROOT_HOST=%

# ---------- Redis ----------
REDIS_VERSION=7.2
REDIS_HOST_PORT=6379
REDIS_CONF_FILE=./services/redis/redis.conf

# ---------- Memcached ----------
MEMCACHED_VERSION=1.6
MEMCACHED_HOST_PORT=11211
MEMCACHED_CACHE_SIZE=64

# ---------- Go ----------
GO_VERSION=1.22
GO_PROXY=https://goproxy.cn,direct
GO_HOST_PORT=9100
GO_APP_DIR=./goapp
GO_LOG_DIR=./logs/go